{
  "name": "aidlc-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Tracks AI-DLC open questions, approvals and progress across GitHub and GitLab repos.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "aidlc-tracker": "bin/aidlc-tracker.mjs"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "dev": "LOCAL_REPOS=fixtures/repos/acme-shop node --disable-warning=ExperimentalWarning --watch server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.mjs\"",
    "inbox": "node bin/aidlc-tracker.mjs inbox fixtures/repos/acme-shop",
    "status": "node bin/aidlc-tracker.mjs status fixtures/repos/acme-shop",
    "smoke": "node scripts/smoke.mjs"
  }
}
